{
  "ConnectionStrings": {
    "AurelynConnection": ""
  },

  "Cors": {
    "AllowedOrigins": [
      "",
      ""
    ]
  },

  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "AurelynApi",
    "Audience": "AurelynClient",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "OtpSettings": {
    "ExpiryMinutes": 5,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxResendsPerHour": 5
  },

  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "youraccount@gmail.com",
    "Password": "",
    "FromEmail": "youraccount@gmail.com",
    "FromName": "Aurelyn Care"
  },

  "AllowedHosts": "*"
}